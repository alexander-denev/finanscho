{
  "name": "finanscho",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first personal finance manager with optional WebDAV sync.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:pwa",
    "verify:pwa": "node scripts/verifyPwaBuild.js",
    "init-install": "npm install"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "@preact/signals-core": "^1.14.4",
    "idb": "^8.0.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.5",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "lucide": "^1.54.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^13.0.6"
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
